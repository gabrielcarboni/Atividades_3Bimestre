programa
{
	funcao inicio()
	{
		real numeros[5]
		real maior
		inteiro i

		para(i = 0; i < 5; i++)
		{
			escreva("Digite o ", i + 1, " numero: ")
			leia(numeros[i])
		}

		maior = numeros[0]

		para(i = 1; i < 5; i++)
		{
			se(numeros[i] > maior)
			{
				maior = numeros[i]
			}
		}

		escreva("Maior numero: ", maior)
	}
}
