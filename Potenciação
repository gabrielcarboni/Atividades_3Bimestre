programa
{
	funcao inicio()
	{
		inteiro base
		inteiro expoente
		inteiro resultado = 1
		inteiro i

		escreva("Digite a base: ")
		leia(base)

		escreva("Digite o expoente: ")
		leia(expoente)

		para(i = 1; i <= expoente; i++)
		{
			resultado = resultado * base
		}

		escreva("Resultado: ", resultado)
	}
}
