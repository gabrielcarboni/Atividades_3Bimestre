programa
{
	funcao inicio()
	{
		real numeros[5]
		real soma = 0
		real media
		inteiro i

		para(i = 0; i < 5; i++)
		{
			escreva("Digite o ", i + 1, " numero: ")
			leia(numeros[i])

			soma = soma + numeros[i]
		}

		media = soma / 5

		escreva("Soma: ", soma, "\n")
		escreva("Media: ", media)
	}
}
